---
/**
 * Work — brutalist horizontally-pinned gallery.
 *
 *  - Intro block scrolls normally (kinetic [data-split] title).
 *  - [data-h-scroll] / [data-h-track] are pinned + scrubbed sideways by
 *    scripts/scroll-fx.ts on desktop (>=821px); on mobile it falls back to a
 *    normal vertical stack (no JS transform applied).
 *  - Cards keep the optimized <Image>; invert to accent on hover.
 */
import { Image } from 'astro:assets';
import { projects, workIntro, profile } from '../data/portfolio';
---

<section class="work" id="work">
  <div class="work__intro">
    <p class="section-tag" data-reveal>02 / Work</p>
    <h2 class="work__title" data-split>{workIntro.title}</h2>
    <div class="work__meta">
      <p class="work__lead" data-reveal style="--i: 1">{workIntro.lead}</p>
      <p class="work__hint label" data-reveal style="--i: 2">Scroll&nbsp;→&nbsp;to&nbsp;explore</p>
    </div>
  </div>

  <div class="work__pin" data-h-scroll>
    <div class="work__track" data-h-track>
      {
        projects.map((p, i) => (
          <article class="wcard">
            <header class="wcard__head u-mono">
              <span class="wcard__index">{String(i + 1).padStart(2, '0')}</span>
              <span>{p.year}</span>
            </header>

            <div class="wcard__media">
              <Image
                src={p.image}
                alt={`${p.title} preview`}
                widths={[400, 560, 800]}
                sizes="(max-width: 820px) 92vw, 540px"
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
              />
              {p.metric && (
                <span class="wcard__metric u-mono">
                  <b>{p.metric.value}</b> {p.metric.label}
                </span>
              )}
            </div>

            <div class="wcard__body">
              <h3 class="wcard__title">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" data-cursor-label="Visit">
                    {p.title} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <p class="wcard__desc">{p.description}</p>
              <ul class="wcard__tags u-mono">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }

      <a class="work__end" href={`mailto:${profile.email}`} data-cursor-label="Email">
        <span class="label">Have something in mind?</span>
        <span class="work__end-big u-display">Let’s build →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .work { position: relative; z-index: 2; }

  /* --- Intro (normal flow) --------------------------------------------- */
  .work__intro {
    max-width: 1500px;
    margin-inline: auto;
    padding: clamp(5rem, 3rem + 7vw, 9rem) var(--gutter) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .work__title {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 1.2rem + 6vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .work__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 2vw, 2.5rem);
  }
  .work__lead { max-width: 52ch; font-size: var(--step-1); color: var(--fg-dim); }
  .work__hint { white-space: nowrap; color: var(--accent); }

  /* --- Pinned horizontal track (desktop) ------------------------------- */
  .work__pin {
    border-block: var(--bw) solid var(--line-2);
    overflow-x: auto; /* manually scrollable without JS / under reduced motion */
  }
  /* When GSAP is driving the pin, it owns the horizontal movement instead. */
  .work__pin.is-pinned { overflow: hidden; }
  .work__track { display: flex; }

  .wcard {
    flex: 0 0 auto;
    width: clamp(300px, 80vmin, 540px);
    height: min(74vh, 640px);
    display: flex;
    flex-direction: column;
    border-right: var(--bw) solid var(--line-2);
    background: var(--bg);
  }
  .wcard__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.1rem;
    border-bottom: var(--bw) solid var(--line);
    font-size: var(--step--1);
    color: var(--fg-dim);
    letter-spacing: 0.08em;
  }
  .wcard__index { color: var(--accent); }

  .wcard__media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border-bottom: var(--bw) solid var(--line);
  }
  .wcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease), filter 0.5s var(--ease);
    filter: grayscale(0.4) contrast(1.05);
  }
  .wcard__metric {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 0.5em;
    align-items: baseline;
    padding: 0.5rem 0.8rem;
    background: var(--bg);
    border-top: var(--bw) solid var(--line-2);
    border-right: var(--bw) solid var(--line-2);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .wcard__metric b { font-size: 1.1rem; color: var(--accent); }

  .wcard__body {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .wcard__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1vw, 1.7rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .wcard__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fg-dim);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .wcard__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .wcard__tags li {
    padding: 0.25em 0.7em;
    border: var(--bw) solid var(--line-2);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--fg-dim);
    text-transform: uppercase;
  }

  /* Invert-on-hover (brutalist) */
  @media (hover: hover) {
    .wcard:hover .wcard__media :global(img) { transform: scale(1.05); filter: grayscale(0) contrast(1); }
    .wcard:hover .wcard__body { background: var(--accent); color: var(--accent-ink); }
    .wcard:hover .wcard__desc { color: color-mix(in srgb, var(--accent-ink) 75%, transparent); }
    .wcard:hover .wcard__tags li { border-color: color-mix(in srgb, var(--accent-ink) 35%, transparent); color: var(--accent-ink); }
  }

  /* --- End CTA panel ---------------------------------------------------- */
  .work__end {
    flex: 0 0 auto;
    width: clamp(300px, 70vmin, 520px);
    height: min(74vh, 640px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--bg);
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .work__end-big {
    font-size: clamp(2.2rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .work__end:hover { background: var(--accent); color: var(--accent-ink); }
    .work__end:hover .label { color: var(--accent-ink); }
  }

  /* --- Mobile: vertical stack (no pin) --------------------------------- */
  @media (max-width: 820px) {
    .work__track { flex-direction: column; }
    .wcard,
    .work__end {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: var(--bw) solid var(--line-2);
    }
    .wcard__media { aspect-ratio: 16 / 10; flex: 0 0 auto; }
    .work__end { min-height: 50vh; justify-content: flex-end; gap: 2rem; }
  }
</style>
