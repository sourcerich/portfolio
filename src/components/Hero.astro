---
/**
 * Brutalist hero.
 *
 *  - Giant stacked name (Archivo), revealed word-by-word once the preloader
 *    fires 'app:reveal'. Mono labels pin the corners; magnetic CTAs.
 *  - Background: the retuned Three.js "data dust" canvas (hard square points).
 *  - No-JS / reduced-motion: everything is statically visible (no masks left
 *    hidden), entrance is skipped.
 */
import { profile } from '../data/portfolio';
---

<section class="hero" id="hero">
  <canvas id="hero-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <div class="hero__grid">
    <div class="hero__top">
      <p class="hero__status label" data-hero-line>
        <span class="hero__dot" aria-hidden="true"></span>
        {profile.available ? 'Available for work' : 'Currently booked'} — {profile.location}
      </p>
      <p class="label" data-hero-line>(01 / Home)</p>
    </div>

    <h1 class="hero__name">
      <span class="word-mask"><span class="word" data-hero-word>Richie</span></span>
      <span class="word-mask"><span class="word" data-hero-word>Patil</span></span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__subhead" data-hero-line>
        {profile.role} — building robust APIs, data pipelines &amp; applied
        generative AI.
      </p>

      <div class="hero__cta" data-hero-cta>
        <a class="btn btn--solid" href="#work" data-magnetic data-cursor-label="View">
          <span data-magnetic-inner>Selected Work</span>
        </a>
        <a
          class="btn"
          href={profile.resumeUrl}
          target="_blank"
          rel="noopener"
          download
          data-magnetic
        >
          <span data-magnetic-inner>Résumé ↗</span>
        </a>
      </div>
    </div>
  </div>

  <span class="hero__scroll label" aria-hidden="true">Scroll ↓</span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(5.5rem, 11vh, 9rem) var(--gutter) clamp(1.5rem, 4vh, 3rem);
  }

  .hero__top,
  .hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .hero__status { display: inline-flex; align-items: center; gap: 0.6em; }
  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  /* The centrepiece. */
  .hero__name {
    margin-block: auto;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--display);
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .hero__name .word-mask { display: block; }

  .hero__subhead {
    max-width: 42ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--fg-dim);
    text-wrap: balance;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .hero__scroll {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    transform: translateX(-50%);
    color: var(--fg-faint);
  }

  @media (max-width: 640px) {
    .hero__scroll { display: none; }
    .hero__cta .btn { flex: 1; justify-content: center; }
  }
</style>

<script>
  // Boot the canvas; play the entrance once the preloader reveals the page.
  import { gsap } from 'gsap';
  import { initHeroParticles } from '../scripts/hero-particles';

  const canvas = document.getElementById('hero-canvas');
  const particles =
    canvas instanceof HTMLCanvasElement ? initHeroParticles({ canvas }) : null;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const words = gsap.utils.toArray<HTMLElement>('[data-hero-word]');
  const lines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
  const cta = document.querySelector<HTMLElement>('[data-hero-cta]');

  if (!reduced) {
    gsap.set(words, { yPercent: 110 });
    gsap.set(lines, { yPercent: 60, opacity: 0 });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });
  }

  let played = false;
  const play = () => {
    if (played) return;
    played = true;
    if (reduced) return; // already visible
    gsap
      .timeline()
      .to(words, { yPercent: 0, duration: 1.1, ease: 'power4.out', stagger: 0.12 })
      .to(lines, { yPercent: 0, opacity: 1, duration: 0.8, ease: 'power3.out', stagger: 0.08 }, '-=0.7')
      .to(cta, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4');
  };

  window.addEventListener('app:reveal', play, { once: true });
  window.setTimeout(play, 4000); // fallback if the reveal event never arrives

  document.addEventListener('astro:before-swap', () => particles?.destroy(), { once: true });
  if (import.meta.hot) import.meta.hot.dispose(() => particles?.destroy());
</script>
